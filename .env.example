# Judge model — any LiteLLM-supported string (provider chosen by prefix).
# Examples:
#   gemini/gemini-2.5-flash
#   gpt-4o-mini
#   claude-sonnet-4-5
#   ollama/qwen2.5:3b-instruct
JUDGE_MODEL=gemini/gemini-2.5-flash

# Provider API keys (set only the one your JUDGE_MODEL needs).
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Vertex AI (if using gemini via Vertex instead of an API key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# Local inference (Ollama) — only if JUDGE_MODEL starts with ollama/
# OLLAMA_API_BASE=http://localhost:11434
