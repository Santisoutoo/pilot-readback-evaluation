# Copy to `.env` (same folder). `adk web` auto-loads it.

# LiteLLM model string. Use the `ollama_chat/` provider (not `ollama/`).
# The model must be pulled first:  ollama pull qwen2.5:0.5b-instruct
OLLAMA_MODEL=ollama_chat/qwen2.5:0.5b-instruct

# Ollama daemon URL (LiteLLM reads this from the environment).
OLLAMA_API_BASE=http://localhost:11434
